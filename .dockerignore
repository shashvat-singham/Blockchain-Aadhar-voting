# Keep the build context small and keep secrets out of image layers.

node_modules
npm-debug.log*

# Secrets and PII — must never enter an image
.env
.env.*
!.env.example
data/voters.json
data/*.csv
!data/voters.sample.csv

# Build output (regenerated inside the toolchain stage)
artifacts
cache
coverage
coverage.json
typechain-types

# Not needed at runtime
.git
.github
.vercel
test
screenshot
deployments
*.md
!README.md
.solhint.json
.gitignore
.editorconfig
.vscode
.idea
Dockerfile
docker-compose.yml
.dockerignore
