{
  "name": "aadhaar-voting",
  "version": "2.0.0",
  "description": "Wallet-free, gasless blockchain voting system. Static frontend + Vercel serverless relayer + Solidity ballot contract.",
  "private": true,
  "type": "commonjs",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "dev:vercel": "vercel dev",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down -v",
    "docker:logs": "docker compose logs -f app",
    "chain": "hardhat node --hostname 0.0.0.0",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:amoy": "hardhat run scripts/deploy.js --network amoy",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "deploy:private": "hardhat run scripts/deploy.js --network private",
    "seed:local": "hardhat run scripts/seed.js --network localhost",
    "seed:amoy": "hardhat run scripts/seed.js --network amoy",
    "seed:sepolia": "hardhat run scripts/seed.js --network sepolia",
    "seed:private": "hardhat run scripts/seed.js --network private",
    "voters:hash": "node scripts/hash-voters.js",
    "smoke": "node scripts/smoke-test.js",
    "verify": "hardhat verify",
    "lint:sol": "solhint 'contracts/**/*.sol'"
  },
  "dependencies": {
    "ethers": "^6.13.4",
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.22.17",
    "solhint": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shashvat-singham/Blockchain-Aadhar-voting.git"
  },
  "license": "MIT"
}
