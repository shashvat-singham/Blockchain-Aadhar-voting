# Dependencies
node_modules/

# Environment and secrets — never commit these
.env
.env.*
!.env.example

# Electoral roll. Both files are PII: the CSV holds raw Aadhaar numbers, and the
# generated JSON still holds mobile numbers. Supply the roll through
# VOTER_REGISTRY_JSON in production.
data/voters.json
data/*.csv
!data/voters.sample.csv
# Roll staged for a deployment's VOTER_REGISTRY_JSON — still contains phones.
.vercel-registry.json

# Hardhat
artifacts/
cache/
typechain-types/
coverage/
coverage.json

# Deployment records are per-environment; keep the ones you want deliberately
deployments/localhost.json

# Vercel
.vercel/
.vercel_build_output/

# Editors, tooling and OS
.vscode/
.idea/
.claude/
.cursor/
.aider*
*.swp
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-error.log*

# Vercel CLI appends `.vercel` and `.env*` on link. Keep both, but restore the
# exception for the committed template, which `.env*` would otherwise swallow.
.vercel
.env*
!.env.example
