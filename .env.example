# =============================================================================
# Aadhaar Voting — environment
#
# Copy to .env.local for `vercel dev`, and set the same keys in the Vercel
# dashboard (Project → Settings → Environment Variables) for deployments.
#
# Generate every secret below with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# =============================================================================

# --- Blockchain --------------------------------------------------------------
# Where the backend reads and writes. May contain a provider API key, so this
# value is never sent to the browser.
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# Printed by `npm run deploy:<network>`.
CONTRACT_ADDRESS=

# The relayer signs and pays gas for every ballot. This is the key that removes
# MetaMask from the voter's path — keep it funded, and keep it separate from
# the owner key so a leak cannot also close the election or edit the ballot.
RELAYER_PRIVATE_KEY=

# Owner/authority key. Only used by the deploy and seed scripts, never at
# runtime. Do NOT set this in Vercel.
DEPLOYER_PRIVATE_KEY=

# Handed to the browser so anyone can verify tallies without a wallet.
# Must be a keyless public endpoint — not a copy of RPC_URL if that has a key.
PUBLIC_RPC_URL=https://rpc-amoy.polygon.technology

# Base URL for transaction links on receipts.
EXPLORER_TX_URL=https://amoy.polygonscan.com/tx

# Confirmations to wait for before telling the voter their ballot is final.
TX_CONFIRMATIONS=1
TX_TIMEOUT_MS=60000

# Relayer balance below which /api/health reports degraded (wei; 0.05 default).
# Ignored when GAS_PRICE_WEI=0, since there is nothing to run out of.
RELAYER_MIN_BALANCE_WEI=50000000000000000

# --- Gas policy --------------------------------------------------------------
# Leave UNSET on a public network: the node quotes the market rate and the
# relayer pays it, so the voter still pays nothing.
#
# Set to 0 on a zero-fee chain (a private Besu/Geth/Quorum network started with
# a zero minimum gas price, or the bundled dev chain). Ballots then cost
# literally nothing -- the relayer's balance never moves and can never run dry.
# Verified by `npm run smoke`, which asserts the balance is unchanged.
GAS_PRICE_WEI=

# --- Secrets (32+ chars each, all different) ---------------------------------
# Encrypts the OTP challenge and voting session tokens.
SESSION_SECRET=

# Derives the on-chain voter nullifier. NEVER rotate mid-election: doing so
# resets every "already voted" marker and lets people vote twice.
NULLIFIER_SECRET=

# Peppers the electoral roll lookup. Rotating this requires regenerating
# data/voters.json with `npm run voters:hash`.
AADHAAR_PEPPER=

# --- One-time codes ----------------------------------------------------------
# console | twilio | msg91. `console` only logs the code and is refused in
# production.
OTP_TRANSPORT=console
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_LENGTH=6
SESSION_TTL_SECONDS=900

# Returns the code in the API response so you can test without an SMS gateway.
# Ignored when running in production.
DEV_ECHO_OTP=true

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# MSG91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# --- Electoral roll ----------------------------------------------------------
# Preferred in production: the whole registry as one JSON string, so PII lives
# in the secret store rather than in git. Falls back to data/voters.json.
VOTER_REGISTRY_JSON=

# --- Results policy ----------------------------------------------------------
# after-close (default) | live
RESULTS_VISIBILITY=after-close

# --- Rate limiting (strongly recommended in production) ----------------------
# Without these, limits are per serverless instance rather than global.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Contract verification (deploy scripts only) -----------------------------
POLYGONSCAN_API_KEY=
ETHERSCAN_API_KEY=
